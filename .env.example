POSTGRES_DB=geoagentic
POSTGRES_USER=geoagentic
POSTGRES_PASSWORD=geoagentic
DATABASE_URL=postgresql+psycopg://geoagentic:geoagentic@db:5432/geoagentic
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,api
API_KEY=
ENVIRONMENT=development
DOCS_ENABLED=true
# Decision tuning
RESPONSE_TARGET_MIN=15
COVERAGE_TARGET_MIN=10
# Optional: lets GeoAgent re-phrase answers (numbers are verified against the engine's facts)
ANTHROPIC_API_KEY=

# External providers (optional). Without them the platform runs on its built-in demo graph and local data.
ROUTING_PROVIDER=google
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTING_PREFERENCE=TRAFFIC_AWARE
MAPBOX_ACCESS_TOKEN=
TRAFFIC_PROVIDER=local
TOMTOM_API_KEY=
INCIDENT_SYNC_SECONDS=60
FLEET_PROVIDER=local
FLEET_API_URL=
FLEET_API_USERNAME=
FLEET_API_PASSWORD=
TRACCAR_DEVICE_MAP=
PROVIDER_TIMEOUT_SECONDS=5
# Control loop rate (0.2 = every 5 s; 0 disables it)
TWIN_TICK_HZ=0.2

# Local demo: the mission control loop advances the dispatched vehicle about 1 simulated minute per tick.
# TWIN_TICK_HZ=0.2 means one tick every 5 seconds, so the automatic 5-minute hospital update appears in ~25 seconds.
